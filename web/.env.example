# =============================================================================
# PÚBLICAS (NEXT_PUBLIC_*) — embutidas no bundle JS enviado ao navegador.
# Seguras para expor: a segurança do app vem do Row Level Security no
# Postgres, nunca do sigilo dessas duas chaves. Ver docs/SECURITY.md.
# =============================================================================

# Project Settings -> API no dashboard do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL canônica deste app, usada para montar links absolutos (confirmação de
# email, retorno de checkout de billing, metadata/sitemap/robots). Em
# produção, aponte para o domínio real (ex: https://app.seusite.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Arquitetura de subdomínios (opcional, ver docs/ARCHITECTURE.md
# "Subdomínios"). Deixe as três em branco para rodar tudo em um domínio só
# (comportamento atual/padrão) -- é isso que o middleware faz quando elas
# não estão configuradas. Preencha as três (com hosts diferentes) quando
# quiser separar de fato: app.seusite.com para o produto autenticado,
# agenda.seusite.com para as páginas públicas de agendamento, e
# www.seusite.com/seusite.com para o site institucional. Isto NÃO é domínio
# customizado por cliente/tenant -- é a separação de domínios da própria
# plataforma.
# NEXT_PUBLIC_APP_URL=https://app.seusite.com
# NEXT_PUBLIC_AGENDA_URL=https://agenda.seusite.com
# NEXT_PUBLIC_MARKETING_URL=https://www.seusite.com

# =============================================================================
# PRIVADAS — server-only. NUNCA prefixar com NEXT_PUBLIC_, nunca importar de
# um Client Component, nunca commitar um valor real. Configure-as na Vercel
# como "Production"/"Preview" (não em "Sensitive"->expor ao build do
# navegador) -- variáveis sem o prefixo já não são enviadas ao bundle.
# =============================================================================

# Ignora Row Level Security por completo. Usada apenas em
# src/lib/supabase/admin.ts (marcado "server-only"), no webhook de billing
# (src/app/api/webhooks/billing/[provider]/route.ts) e no provedor de
# billing local (src/lib/billing/providers/local.ts) -- nenhum desses pontos
# confia em business_id vindo do cliente sem antes resolver a sessão ou
# validar a assinatura do webhook. Ver docs/SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billing (opcional -- ver docs/BILLING.md). Deixe BILLING_PROVIDER em
# branco para rodar toda empresa no provedor 'local' embutido: mudança de
# plano aplica na hora, sem cobrança real, sem webhook necessário. Defina
# como 'mercadopago' | 'stripe' | 'asaas' para usar um provedor de verdade,
# e preencha só o bloco daquele provedor.
# BILLING_PROVIDER=mercadopago

# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_IDS={"start":"price_...","pro":"price_...","business":"price_..."}

# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# =============================================================================
# SECRETS DE EDGE FUNCTIONS — NÃO vão na Vercel nem em .env.local. São lidas
# por `Deno.env.get()` dentro de supabase/functions/*, que roda no Supabase,
# não no Next.js. Configure-as com o Supabase CLI:
#
#   supabase secrets set CRON_SECRET=... WHATSAPP_ACCESS_TOKEN=... \
#     WHATSAPP_PHONE_NUMBER_ID=... RESEND_API_KEY=... \
#     EMAIL_FROM_ADDRESS="Aureon Agenda <agenda@seusite.com>"
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente
# pelo Supabase em toda Edge Function -- não precisam (e não devem) ser
# definidas manualmente. Ver docs/NOTIFICATIONS.md.
# =============================================================================

# Compartilhado por ambas as functions (appointment-reminders,
# process-notifications): token que só o Supabase Cron conhece, enviado no
# header Authorization das chamadas agendadas -- sem ele, a function recusa
# a requisição (evita que qualquer um dispare o processamento manualmente).
# CRON_SECRET=

# WhatsApp Cloud API (opcional -- sem elas, notificações de WhatsApp ficam
# como "sem provedor configurado" e não bloqueiam o resto do fluxo).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Resend (opcional, mesmo comportamento de fallback do WhatsApp acima).
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
