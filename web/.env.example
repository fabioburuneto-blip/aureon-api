# Projeto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública do site, usada para gerar links absolutos nas meta tags (og:image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente no servidor (NUNCA com prefixo NEXT_PUBLIC_): usada pelo admin para criar usuários.
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
