# Supabase project credentials (Project Settings > API in the Supabase dashboard).
# Safe to expose to the browser -- protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret. NEVER prefix with NEXT_PUBLIC_, never import it from a
# Client Component, and never commit a real value. Used by the billing
# webhook route and the 'local' billing provider (src/lib/supabase/admin.ts)
# to write subscriptions data that no user session is allowed to touch.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build absolute links (e.g. in emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Billing (optional -- see docs/BILLING.md). Leave BILLING_PROVIDER unset
# to run every business on the built-in 'local' provider: plan changes
# apply immediately, no real charge, no webhook needed. Set it to
# 'mercadopago' | 'stripe' | 'asaas' to go live with that provider, and
# fill in only that provider's block below.
# BILLING_PROVIDER=mercadopago

# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_IDS={"start":"price_...","pro":"price_...","business":"price_..."}

# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
